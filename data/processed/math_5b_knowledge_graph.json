    {
      "id": "math_5b_rjb_cpt1",
      "label": "Concept",
      "name": "从不同方向观察几何体",
      "properties": {
        "definition": "从前面、左面、上面等不同方向观察由小正方体搭成的几何体，会看到不同的平面图形。",
        "importance": "掌握",
        "examples": [
          "从前面看到的是两个方块高的形状，从左面看到可能是一列方块"
        ],
        "pages": "观察物体（三）第1-3页"
      }
    },
    {
      "id": "math_5b_rjb_cpt10",
      "label": "Concept",
      "name": "5的倍数特征",
      "properties": {
        "definition": "个位上是0或5的整数都是5的倍数。",
        "importance": "掌握",
        "pages": "5的倍数特点部分"
      }
    },
    {
      "id": "math_5b_rjb_cpt11",
      "label": "Concept",
      "name": "2的倍数特征",
      "properties": {
        "definition": "个位上是0、2、4、6或8的整数都是2的倍数。",
        "importance": "掌握",
        "pages": "2的倍数特点部分"
      }
    },
    {
      "id": "math_5b_rjb_cpt12",
      "label": "Concept",
      "name": "完全数",
      "properties": {
        "definition": "等于除自身外全部因数之和的数叫完全数。",
        "importance": "了解",
        "pages": "完全数介绍",
        "examples": [
          "6，28"
        ]
      }
    },
    {
      "id": "math_5b_rjb_cpt13",
      "label": "Concept",
      "name": "长方体的长宽高",
      "properties": {
        "definition": "在长方体中，相交于同一顶点的三条棱分别称为长、宽、高。",
        "importance": "理解",
        "pages": "第1节"
      }
    },
    {
      "id": "math_5b_rjb_cpt14",
      "label": "Concept",
      "name": "表面积",
      "properties": {
        "definition": "长方体或正方体6个面的面积之和叫做它的表面积。",
        "importance": "掌握",
        "pages": "第2节"
      }
    },
    {
      "id": "math_5b_rjb_cpt15",
      "label": "Concept",
      "name": "体积",
      "properties": {
        "definition": "物体所占空间的大小叫做物体的体积，体积单位包括立方厘米、立方分米和立方米。",
        "importance": "掌握",
        "pages": "第3节"
      }
    },
    {
      "id": "math_5b_rjb_cpt16",
      "label": "Concept",
      "name": "长方体体积公式",
      "properties": {
        "definition": "长方体体积=长×宽×高，也可写为V=a·b·h。",
        "importance": "掌握",
        "formula": "V=a·b·h",
        "pages": "第3节"
      }
    },
    {
      "id": "math_5b_rjb_cpt17",
      "label": "Concept",
      "name": "正方体体积公式",
      "properties": {
        "definition": "正方体体积=棱长×棱长×棱长，写作V=a³。",
        "importance": "掌握",
        "formula": "V=a³",
        "pages": "第3节"
      }
    },
    {
      "id": "math_5b_rjb_cpt18",
      "label": "Concept",
      "name": "分数的意义",
      "properties": {
        "definition": "把单位“1”平均分成若干份，其中一份或若干份用分数表示。",
        "importance": "掌握"
      }
    },
    {
      "id": "math_5b_rjb_cpt19",
      "label": "Concept",
      "name": "单位1",
      "properties": {
        "definition": "表示一个整体，可以是一个物体、一个计量单位或一些物体。",
        "importance": "掌握"
      }
    },
    {
      "id": "math_5b_rjb_cpt2",
      "label": "Concept",
      "name": "倍数",
      "properties": {
        "definition": "在整数除法中，如果一个整数能够被另一个整数整除，那么前者是后者的倍数。",
        "importance": "掌握",
        "examples": [
          "12是2的倍数，因为12÷2=6",
          "12是2的倍数"
        ],
        "pages": "因数和倍数 第1页"
      }
    },
    {
      "id": "math_5b_rjb_cpt20",
      "label": "Concept",
      "name": "分数单位",
      "properties": {
        "definition": "把单位1平均分成若干份后，其中一份表示的分数。",
        "importance": "掌握"
      }
    },
    {
      "id": "math_5b_rjb_cpt21",
      "label": "Concept",
      "name": "分数与除法的关系",
      "properties": {
        "definition": "a ÷ b = a/b（b ≠ 0），除法的商可以用分数表示。",
        "importance": "重要"
      }
    },
    {
      "id": "math_5b_rjb_cpt22",
      "label": "Concept",
      "name": "真分数",
      "properties": {
        "definition": "分子小于分母的分数，数值小于1。",
        "importance": "掌握"
      }
    },
    {
      "id": "math_5b_rjb_cpt23",
      "label": "Concept",
      "name": "假分数",
      "properties": {
        "definition": "分子大于或等于分母的分数，数值大于或等于1。",
        "importance": "掌握"
      }
    },
    {
      "id": "math_5b_rjb_cpt24",
      "label": "Concept",
      "name": "带分数",
      "properties": {
        "definition": "由整数和真分数组成的数，如2又1/5。",
        "importance": "了解"
      }
    },
    {
      "id": "math_5b_rjb_cpt25",
      "label": "Concept",
      "name": "分数的基本性质",
      "properties": {
        "definition": "分子和分母同时乘或除以相同的数（0除外），分数大小不变。",
        "importance": "重要"
      }
    },
    {
      "id": "math_5b_rjb_cpt26",
      "label": "Concept",
      "name": "约分",
      "properties": {
        "definition": "将分子和分母同时除以它们的公因数，使分数变成最简分数。",
        "importance": "重要"
      }
    },
    {
      "id": "math_5b_rjb_cpt27",
      "label": "Concept",
      "name": "通分",
      "properties": {
        "definition": "把几个分数化成同分母的分数以便比较大小或进行运算。",
        "importance": "重要"
      }
    },
    {
      "id": "math_5b_rjb_cpt28",
      "label": "Concept",
      "name": "最大公因数",
      "properties": {
        "definition": "同时是两个或多个数的因数的最大值。",
        "importance": "掌握"
      }
    },
    {
      "id": "math_5b_rjb_cpt29",
      "label": "Concept",
      "name": "最小公倍数",
      "properties": {
        "definition": "同时是两个或多个数的倍数的最小值。",
        "importance": "掌握"
      }
    },
    {
      "id": "math_5b_rjb_cpt3",
      "label": "Concept",
      "name": "偶数",
      "properties": {
        "definition": "能被2整除的整数叫偶数（0也是偶数）。",
        "importance": "了解",
        "examples": [
          "0, 2, 4, 6, 8"
        ],
        "pages": "2、5、3 的倍数 第3页"
      }
    },
    {
      "id": "math_5b_rjb_cpt30",
      "label": "Concept",
      "name": "分数与小数互化",
      "properties": {
        "definition": "分数可通过除法化成小数，小数可按位值写成分数并化简。",
        "importance": "掌握"
      }
    },
    {
      "id": "math_5b_rjb_cpt31",
      "label": "Concept",
      "name": "旋转中心",
      "properties": {
        "definition": "图形旋转时保持不动的点，其他点都围绕该点运动。",
        "importance": "掌握",
        "pages": "例题与做一做中多次出现",
        "examples": [
          "钟表的表盘中心",
          "风车叶片的固定点"
        ]
      }
    },
    {
      "id": "math_5b_rjb_cpt32",
      "label": "Concept",
      "name": "旋转方向",
      "properties": {
        "definition": "指图形旋转时的方向，包括顺时针方向和逆时针方向。",
        "importance": "掌握",
        "aliases": [
          "顺时针旋转",
          "逆时针旋转"
        ]
      }
    },
    {
      "id": "math_5b_rjb_cpt33",
      "label": "Concept",
      "name": "旋转角度",
      "properties": {
        "definition": "图形围绕旋转中心转动的角度大小，如90°、180°等。",
        "importance": "掌握"
      }
    },
    {
      "id": "math_5b_rjb_cpt34",
      "label": "Concept",
      "name": "旋转的性质",
      "properties": {
        "definition": "旋转保持图形形状和大小不变，对应点到中心的距离相等，对应线段与中心的夹角等于旋转角。",
        "importance": "了解",
        "examples": [
          "旋转前后两三角形ABC与A'B'C'全等"
        ]
      }
    },
    {
      "id": "math_5b_rjb_cpt35",
      "label": "Concept",
      "name": "异分母分数加减法",
      "properties": {
        "definition": "分母不同的分数相加减，需要先通分为同分母分数，再按同分母分数加减法计算。",
        "importance": "掌握",
        "pages": "教材第6章",
        "examples": [
          "1/8+1/4",
          "5/8+1/3"
        ]
      }
    },
    {
      "id": "math_5b_rjb_cpt36",
      "label": "Concept",
      "name": "分数加法运算律",
      "properties": {
        "definition": "分数加法满足交换律和结合律。",
        "importance": "了解",
        "examples": [
          "a/b+c/d=c/d+a/b",
          "(a/b+c/d)+e/f=a/b+(c/d+e/f)"
        ]
      }
    },
    {
      "id": "math_5b_rjb_cpt37",
      "label": "Concept",
      "name": "分数混合运算",
      "properties": {
        "definition": "分数加减混合运算的顺序与整数加减相同，需要先通分再按运算顺序计算。",
        "importance": "重要",
        "examples": [
          "1/2+3/10-1/5"
        ]
      }
    },
    {
      "id": "math_5b_rjb_cpt38",
      "label": "Concept",
      "name": "折线统计图",
      "properties": {
        "definition": "用高低不同的点表示数据的大小，通过点与点的连线显示数据的变化趋势。",
        "importance": "重要",
        "pages": "教材第7章开头",
        "examples": [
          "1998—2021年全国总人口数折线统计图"
        ]
      }
    },
    {
      "id": "math_5b_rjb_cpt39",
      "label": "Concept",
      "name": "复式折线统计图",
      "properties": {
        "definition": "在同一坐标系内用两条或多条折线对比不同数据的变化情况。",
        "importance": "重要",
        "examples": [
          "出生人口数和死亡人口数统计图"
        ]
      }
    },
    {
      "id": "math_5b_rjb_cpt4",
      "label": "Concept",
      "name": "奇数",
      "properties": {
        "definition": "不能被2整除的整数叫奇数。",
        "importance": "了解",
        "examples": [
          "1,3,5,7,9"
        ],
        "pages": "2、5、3 的倍数 第3页"
      }
    },
    {
      "id": "math_5b_rjb_cpt40",
      "label": "Concept",
      "name": "数据变化趋势",
      "properties": {
        "definition": "通过统计图观察数据随时间的增减变化规律。",
        "importance": "掌握",
        "examples": [
          "人口逐年上升但幅度变小"
        ]
      }
    },
    {
      "id": "math_5b_rjb_cpt41",
      "label": "Concept",
      "name": "人口自然增长数",
      "properties": {
        "definition": "出生人口数减去死亡人口数得到的数值。",
        "importance": "了解",
        "pages": "教材后段",
        "examples": [
          "教材示例给出的计算示意"
        ]
      }
    },
    {
      "id": "math_5b_rjb_cpt42",
      "label": "Concept",
      "name": "天平比较质量的基本原理",
      "properties": {
        "definition": "利用天平两端物体质量的比较结果（平衡或不平衡）来判断物体质量是否相同及谁更重。",
        "importance": "重要",
        "pages": "第8章开头",
        "examples": [
          "天平平衡表示两边质量相等，不平衡表示一边更重。"
        ]
      }
    },
    {
      "id": "math_5b_rjb_cpt43",
      "label": "Concept",
      "name": "用天平寻找次品",
      "properties": {
        "definition": "通过对给定物品进行合理分组并称量，利用每次称量的结果逐步缩小范围，最终找出质量与其他物品不同的次品。",
        "importance": "重要",
        "pages": "第8章找次品任务",
        "examples": [
          "3瓶钙片中1瓶少3片，通过1次称量即可找到次品。"
        ]
      }
    },
    {
      "id": "math_5b_rjb_cpt44",
      "label": "Concept",
      "name": "最少称量次数",
      "properties": {
        "definition": "在已知只有1个次品（且明确比正常物品重或轻）的情况下，为保证一定能找出次品所需的最少称量次数。",
        "importance": "掌握",
        "pages": "第8章“至少称几次能保证找出次品”",
        "examples": [
          "8个零件中1个较重的次品，至少需要2次称量。"
        ]
      }
    },
    {
      "id": "math_5b_rjb_cpt45",
      "label": "Concept",
      "name": "物品数量与最少称量次数的关系",
      "properties": {
        "definition": "在使用天平寻找单个次品时，能在 k 次称量内保证找到次品的物品数量有上限。教材给出的关系：2~3个需1次，4~9个需2次，10~27个需3次，28~81个需4次……",
        "importance": "重要",
        "pages": "“你知道吗？”表格",
        "examples": [
          "若有27个物品，3次称量足够；若有28个，则至少需要4次。"
        ]
      }
    },
    {
      "id": "math_5b_rjb_cpt5",
      "label": "Concept",
      "name": "3的倍数特征",
      "properties": {
        "definition": "一个整数各位数字之和是3的倍数，则该数是3的倍数。",
        "importance": "重要",
        "pages": "2、5、3 的倍数 第4页"
      }
    },
    {
      "id": "math_5b_rjb_cpt6",
      "label": "Concept",
      "name": "质数",
      "properties": {
        "definition": "只有1和它本身两个因数的数叫质数。",
        "importance": "重要",
        "examples": [
          "2,3,5,7,11"
        ],
        "pages": "质数和合数 第1页"
      }
    },
    {
      "id": "math_5b_rjb_cpt7",
      "label": "Concept",
      "name": "合数",
      "properties": {
        "definition": "除了1和本身外还有其他因数的自然数。",
        "importance": "重要",
        "examples": [
          "4,6,8,9"
        ],
        "pages": "质数和合数 第1页"
      }
    },
    {
      "id": "math_5b_rjb_cpt8",
      "label": "Concept",
      "name": "因数的个数有限",
      "properties": {
        "definition": "一个数的因数只有有限个。",
        "importance": "了解",
        "pages": "因数与倍数小结"
      }
    },
    {
      "id": "math_5b_rjb_cpt9",
      "label": "Concept",
      "name": "倍数的个数无限",
      "properties": {
        "definition": "一个数的倍数有无限多个。",
        "importance": "了解",
        "pages": "因数与倍数小结"
      }
    },
    {
