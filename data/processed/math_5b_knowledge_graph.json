      "label": "Skill",
      "name": "根据特征判断倍数",
      "properties": {
        "description": "利用个位特征或数字和特征判断一个数是否为2、5、3的倍数。"
      }
    },
    {
      "id": "math_5b_rjb_skl3",
      "label": "Skill",
      "name": "寻找因数",
      "properties": {
        "description": "通过除法或系统枚举的方法找出一个数的全部因数。"
      }
    },
    {
      "id": "math_5b_rjb_skl4",
      "label": "Skill",
      "name": "对立体图形特征的观察与分类",
      "properties": {
        "description": "通过观察面、棱、顶点等要素判断立体图形的类型及特征，例如判断形状是否为长方体或正方体。"
      }
    },
    {
      "id": "math_5b_rjb_skl5",
      "label": "Skill",
      "name": "将立体图形展开与还原",
      "properties": {
        "description": "根据展开图判断是否能围成给定的长方体或正方体。"
      }
    },
    {
      "id": "math_5b_rjb_skl6",
      "label": "Skill",
      "name": "比较分数大小的方法",
      "properties": {
        "description": "通过通分、同分母比分子、同分子比分母等方法比较分数大小。"
      }
    },
    {
      "id": "math_5b_rjb_skl7",
