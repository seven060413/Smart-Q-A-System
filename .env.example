# ===== Qwen 在线生成接口（阿里云 DashScope，OpenAI 兼容）=====
# 密钥从 https://dashscope.console.aliyun.com/ 获取
QWEN_API_KEY=sk-你的密钥
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ===== 语音识别（ASR，阿里云百炼 Qwen-ASR，OpenAI 兼容 Chat Completions）=====
# 只配置在服务器 / 本机 .env；不要写进前端、APK、H5 或代码，也不要提交到 Git。
# Base URL 必须使用与 Key 匹配的地域 / Workspace 专属地址：
#   北京：  https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
#   新加坡：https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# 也可使用同地域的公共地址：https://dashscope.aliyuncs.com/compatible-mode/v1
# 前端只调用后端 /api/transcribe，由后端访问语音识别服务，不直接请求百炼。
ASR_API_KEY=sk-你的语音识别密钥
ASR_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
ASR_MODEL=qwen3-asr-flash

# ===== bge-m3 向量模型（本地 CPU 加载，首次运行自动下载）=====
BGE_MODEL=BAAI/bge-m3

# ===== 数据路径 =====
DATA_DIR=data
# 可选：SQLite 数据库路径；默认 data/app/ikgr.db
# IKGR_DB_PATH=data/app/ikgr.db

# ===== 学生端认证 =====
# 登录令牌有效期（天），默认 30
AUTH_TOKEN_TTL_DAYS=30
# 开发/测试可设为 false 关闭内存限流；生产不要关闭
AUTH_RATE_LIMIT_ENABLED=true
# 可选：登录失败与注册限流参数（默认 10 次/15 分钟、5 次/小时）
# AUTH_LOGIN_FAILURE_LIMIT=10
# AUTH_LOGIN_WINDOW_SECONDS=900
# AUTH_REGISTER_LIMIT=5
# AUTH_REGISTER_WINDOW_SECONDS=3600
# 可选：scrypt 成本参数，默认 32768；一般不要修改
# AUTH_SCRYPT_N=32768
