# ===== Qwen 在线生成接口（阿里云 DashScope，OpenAI 兼容）=====
# 密钥从 https://dashscope.console.aliyun.com/ 获取
QWEN_API_KEY=sk-你的密钥
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ===== bge-m3 向量模型（本地 CPU 加载，首次运行自动下载）=====
BGE_MODEL=BAAI/bge-m3

# ===== 数据路径 =====
DATA_DIR=data
